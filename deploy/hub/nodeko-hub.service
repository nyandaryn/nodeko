[Unit]
Description=nodeko hub — мониторинг серверов (127.0.0.1:4170)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nodeko
EnvironmentFile=%h/.config/nodeko/hub.env
ExecStart=%h/.bun/bin/bun src/hub/main.ts
Restart=always
RestartSec=5
StartLimitBurst=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
