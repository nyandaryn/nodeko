{
  "name": "nodeko",
  "version": "1.0.0",
  "description": "Self-hosted server and service monitoring with a tech-tree UI, end-to-end encrypted agents and an MCP server for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyandaryn/nodeko.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev:hub": "NODEKO_DATA=./data NODEKO_PUBLIC_URL=http://localhost:5173 bun --watch src/hub/main.ts",
    "dev:web": "bunx --bun vite --config web/vite.config.ts",
    "dev:agent": "bun src/agent/main.ts --config ./data/agent-dev.json",
    "build:web": "bunx --bun vite build --config web/vite.config.ts",
    "build:agent": "bun scripts/build-agent.ts",
    "build": "bun run build:web && bun run build:agent",
    "start": "NODE_ENV=production bun src/hub/main.ts",
    "admin": "bun src/hub/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "uplot": "1.6.32",
    "vite": "8.3.8",
    "wouter": "3.13.0"
  }
}
